# 数据隐站 L3 商业服务配置示例
# 复制为 commercial/.env 后按需修改；run_dev.py 会自动读取 commercial/.env
# 注意：.env 与密钥文件不要提交到 git（见 .gitignore）。

# ── 基础 ──
COMMERCIAL_HOST=127.0.0.1
COMMERCIAL_PORT=8787
COMMERCIAL_BASE_URL=http://127.0.0.1:8787      # 生产：https://buysd.blctek.com（反向代理到 127.0.0.1:8787）
COMMERCIAL_DATA_DIR=commercial/var
COMMERCIAL_DB=commercial/var/commercial.db
COMMERCIAL_CORS_EXTRA_ORIGINS=                  # 逗号分隔；默认还允许 http://127.0.0.1:<任意端口> / http://localhost:<任意端口>

# ── 支付通道：mock（本地演示）或 alipay ──
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=true                       # provider=mock 时自动 true

# ── 支付宝（真实接单时填；适配器见 commercial/server/payments/alipay.py 与 docs/alipay-setup.md） ──
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY_PATH=commercial/var/keys/alipay_app_private.pem
ALIPAY_PUBLIC_KEY_PATH=commercial/var/keys/alipay_public.pem
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_PAY_MODE=precreate                       # precreate=扫码（推荐，需当面付）；page=电脑网站支付
ALIPAY_QR_PAY_MODE=2                            # page 模式：2=支付宝页面扫码（二维码在支付宝收银台）；留空=旧行为
ALIPAY_NOTIFY_URL=                              # 不填则 ${COMMERCIAL_BASE_URL}/notify/alipay
ALIPAY_SELLER_ID=                               # 可选校验
ALIPAY_APP_ID_CHECK=1

# T2 适配器可选配置（不配置有默认值）
# ALIPAY_APP_PRIVATE_KEY_PASSWORD=              # 支付宝应用私钥口令（加密 PEM 时）
# ALIPAY_HTTP_TIMEOUT=10                        # 调用支付宝网关超时（秒，上限 60）
# ALIPAY_RETURN_URL=                            # page 模式同步回跳兜底（业务代码会优先传 return_url）

# ── 支付宝主动查单兜底（notify 不可达/延迟时，GET 订单轮询主动向支付宝查单） ──
# 场景：本机/内网联调时支付宝服务器无法回调 notify_url，付款后订单会一直 pending；
# 开启后前端每 2s 轮询 GET /api/orders/{no} 时，服务端对 pending 的支付宝订单按订单节流
# 调用 alipay.trade.query，确认已支付且金额一致即自动 finalize + 签发 license（本机自动解锁）。
# 只在 GET 订单轮询生效；notify 仍保留且幂等；默认关闭（真实收款建议开启）。
ALIPAY_QUERY_FALLBACK=false
# ALIPAY_QUERY_MIN_INTERVAL_SECONDS=5            # 同一订单最小查单间隔（秒，默认 5，最小 2）
# ALIPAY_QUERY_TIMEOUT=10                       # 单次查单 HTTP 超时（秒，默认 10，范围 1~60）

# ── 授权签发（私钥只放商业服务机器；不要进仓库/安装包） ──
LICENSE_PRIVATE_KEY_PATH=%USERPROFILE%\.sanitized-data-license-keys\prod-2026b\license_signing_ed25519.pem
LICENSE_KEY_PASSWORD_ENV=LICENSE_KEY_PASSWORD
LICENSE_KEY_ID=prod-2026b

# ── 价格（分；默认正式价，早鸟价改这里） ──
# 个人版：首年 99 / 续费 129 / 买断 399（含 1 年更新）
COMMERCIAL_PRICE_PERSONAL_CENTS=9900
COMMERCIAL_PRICE_PERSONAL_RENEWAL_CENTS=12900
COMMERCIAL_PRICE_PERSONAL_PERPETUAL_CENTS=39900
COMMERCIAL_PRICE_PRO_CENTS=49900
COMMERCIAL_PRICE_TEAM_CENTS=199900
# 线上自助只开个人版年付/买断；专业版保留后台/人工开通
COMMERCIAL_SELF_SERVE_PRO_ENABLED=false

# ── 管理令牌（预留给未来远程管理接口；admin CLI 以本地文件权限为准） ──
COMMERCIAL_ADMIN_TOKEN=

# ── 可选扩展（不配置即契约默认行为） ──
# COMMERCIAL_ORDER_TTL_SECONDS=900              # 订单有效期（默认 15 分钟）
# COMMERCIAL_RATE_LIMIT_ORDERS_PER_MINUTE=10    # 下单限流（默认 10 次/分钟/IP）
# COMMERCIAL_LOG_LEVEL=INFO
# COMMERCIAL_TRUST_PROXY=false                  # 反向代理后是否信任 X-Forwarded-For（决定限流按真实 IP）


